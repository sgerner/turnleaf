# Loaded as UTF-8 java.util.Properties when present; TURNLEAF_* environment
# variables take precedence over values in this file.
# Escape backslashes (\\), leading spaces (\ ), and leading # or ! (\# / \!),
# or supply raw values through TURNLEAF_* environment variables instead.
# Relative TURNLEAF_STORE_FILE paths resolve from the android/ directory.
TURNLEAF_STORE_FILE=turnleaf-release.jks
TURNLEAF_STORE_PASSWORD=change-me
TURNLEAF_KEY_ALIAS=turnleaf
TURNLEAF_KEY_PASSWORD=change-me
