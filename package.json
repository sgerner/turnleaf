{
  "name": "turnleaf",
  "private": true,
  "version": "0.3.3",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "svelte-check --tsconfig ./tsconfig.app.json",
    "lint": "eslint .",
    "security:audit": "node scripts/security-audit.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark:library": "vitest bench src/lib/components/library-virtualization.bench.ts",
    "build": "npm run check && vite build",
    "verify": "npm run security:audit && npm run format:check && npm run lint && npm run check && npm test && npm run build",
    "dev:kavita": "docker compose -f dev/docker-compose.yml up -d",
    "dev:kavita:down": "docker compose -f dev/docker-compose.yml down",
    "dev:kavita:logs": "docker compose -f dev/docker-compose.yml logs -f kavita",
    "release:finalize": "node scripts/finalize-release-notes.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "setup:hooks": "node scripts/install-githooks.mjs",
    "cap:sync": "npm run build && cap sync",
    "android:open": "node scripts/capacitor-open.mjs android",
    "android:doctor": "node scripts/check-android-sdk.mjs",
    "android:debug": "node scripts/android-build.mjs debug",
    "android:smoke": "node scripts/android-smoke.mjs",
    "android:release": "node scripts/android-build.mjs release",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "node scripts/capacitor-open.mjs ios",
    "postinstall": "node scripts/install-githooks.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor-community/sqlite": "^8.1.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.4.1",
    "@capacitor/file-transfer": "^2.0.4",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/network": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "dompurify": "^3.4.15",
    "epubjs": "^0.3.93",
    "jeep-sqlite": "^2.8.0",
    "sql.js": "^1.14.1",
    "svelte": "^5.56.4"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@eslint/js": "^10.0.1",
    "@skeletonlabs/skeleton": "^4.15.2",
    "@skeletonlabs/skeleton-svelte": "^4.15.2",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.1.0",
    "eslint": "^10.6.0",
    "eslint-plugin-svelte": "^3.20.0",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.4",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.1",
    "tailwindcss": "^4.1.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "epubjs": {
      "@xmldom/xmldom": "0.9.12"
    }
  }
}
